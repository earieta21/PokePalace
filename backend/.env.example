# Backend base
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@HOST/pokepalace
JWT_SECRET=genera-un-secreto-largo
PIN_PEPPER=genera-otro-secreto-largo
SITE_URL=https://www.pokepalace.org

# Uber Eats Marketplace (aplicación TEST)
# Copia estos valores desde Uber Developer Dashboard. Nunca subas el secreto.
UBER_EATS_ENV=sandbox
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
# Clave distinta que configuras como "Signing Key" del webhook en Uber.
UBER_EATS_WEBHOOK_SECRET=
# true: guarda la comanda y la acepta automáticamente en Uber.
# false: la comanda aparece localmente pero debe aceptarse en Uber Eats Orders.
UBER_EATS_AUTO_ACCEPT=true
